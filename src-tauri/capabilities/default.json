{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-start-capture",
    "allow-close-overlay",
    "allow-save-screenshot",
    "allow-copy-screenshot",
    "allow-search-image"
  ]
}
